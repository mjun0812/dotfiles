{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/notify-codex-hook.sh permission",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/rtk-hook.sh",
            "statusMessage": "Rewriting Bash command with RTK",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/wezterm/capture-claude-wezterm-hook.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash '/Users/mjun/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/notify-codex-hook.sh stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/notify-codex-hook.sh turn_start",
            "type": "command"
          }
        ]
      }
    ]
  }
}