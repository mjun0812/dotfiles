{
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/hooks/notify-codex-hook.sh permission",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/hooks/format-hook.sh",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "~/.dotfiles/script/hooks/textlint-report-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(apply_patch|Bash)$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook codex",
            "statusMessage": "Rewriting Bash command with RTK",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/hooks/codex-patch-guard-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(apply_patch|Bash)$"
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/hooks/codex-spawn-agent-guard-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "spawn_agent$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/hooks/capture-wezterm-pane-hook.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/hooks/glossary-context-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/hooks/notify-codex-hook.sh stop",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/script/hooks/notify-codex-hook.sh turn_start",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh working",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
