{
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/notify-codex-hook.sh permission",
            "type": "command"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/codex-rules-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/report-hook.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "^(apply_patch|Bash)$"
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/codex-user-input-timeout-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^request_user_input$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook codex",
            "statusMessage": "Rewriting Bash command with RTK",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/codex-deny-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(apply_patch|Bash)$"
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/codex-rules-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^apply_patch$"
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/codex-spawn-agent-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "spawn_agent$"
      },
      {
        "hooks": [
          {
            "command": "echo 'request_user_input_asyncとsend_message_to_user_asyncは使わないこと。質問や確認はrequest_user_inputで出して回答を待ち、sleepやwaitで返信を待たないこと。' >&2; exit 2",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "^(request_user_input_async|send_message_to_user_async)$"
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/gh-body-hook.sh",
            "timeout": 45,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/capture-wezterm-pane-hook.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/herdr-model-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5,
            "statusMessage": "Loading Rex terminal context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/notify-codex-hook.sh stop",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/notify-codex-hook.sh turn_start",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh working",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/herdr-model-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
