{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "update": "disable",
  "formatter": true,
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "*/sudo *", "effect": "deny" },
    { "action": "shell", "resource": "gh repo delete *", "effect": "ask" },
    { "action": "shell", "resource": "gh release delete *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl delete *", "effect": "ask" },
    { "action": "shell", "resource": "aws s3 rm *", "effect": "ask" },
    { "action": "shell", "resource": "aws s3 rb *", "effect": "ask" },
    // Deny rm regardless of option order; retain Claude's temporary-file cleanup exceptions.
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    { "action": "shell", "resource": "*/rm *", "effect": "deny" },
    { "action": "shell", "resource": "rm /tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "rm -f /tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf /tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "rm /private/tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "rm -f /private/tmp/*", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf /private/tmp/*", "effect": "allow" },
    // V2 checks pipeline commands separately; block common sh stdin-script forms.
    { "action": "shell", "resource": "sh", "effect": "deny" },
    { "action": "shell", "resource": "sh -s *", "effect": "deny" },
    { "action": "shell", "resource": "sh - *", "effect": "deny" },
    { "action": "shell", "resource": "*/sh", "effect": "deny" },
    { "action": "shell", "resource": "*/sh -s *", "effect": "deny" },
    { "action": "shell", "resource": "*/sh - *", "effect": "deny" },
    { "action": "shell", "resource": "*zshrc.local*", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "~/.zshrc.local", "effect": "deny" },
    { "action": "read", "resource": "secrets/*", "effect": "deny" },
    { "action": "read", "resource": "*/secrets/*", "effect": "deny" },
    { "action": "edit", "resource": "*.ipynb", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.agents/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.claude/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.gemini/antigravity-cli/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.dotfiles/config/ai-agents/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" },
  ],
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "anthropic", "effect": "allow" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" },
  ],
}
