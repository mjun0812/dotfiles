{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "update": "disable",
  "formatter": true,
  "permissions": [
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "gh repo delete *", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "~/.agents/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.claude/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.gemini/antigravity-cli/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.config/opencode/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "~/.dotfiles/config/ai-agents/skills/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" },
  ],
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "anthropic", "effect": "allow" },
    { "action": "provider.use", "resource": "openai", "effect": "allow" },
  ],
}
