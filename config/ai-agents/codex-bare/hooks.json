{
  "hooks": {
    "Interrupt": [
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/notify-codex-hook.sh permission",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/capture-wezterm-pane-hook.sh",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/herdr-model-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/notify-codex-hook.sh stop",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/notify-codex-hook.sh turn_start",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash ~/.codex/herdr-agent-state.sh working",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.dotfiles/config/ai-agents/hooks/herdr-model-hook.sh",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
