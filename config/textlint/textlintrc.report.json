{
  "plugins": ["html"],
  "rules": {
    "preset-ai-words-ja": true,
    "@textlint-ja/preset-ai-writing": {
      "ai-tech-writing-guideline": {
        "enableDocumentAnalysis": false
      },
      "no-ai-list-formatting": false,
      "no-ai-colon-continuation": false
    },
    "preset-ja-technical-writing": {
      "sentence-length": false,
      "no-mix-dearu-desumasu": {
        "preferInHeader": "",
        "preferInBody": "",
        "preferInList": "",
        "strict": false
      }
    },
    "no-kangxi-radicals": true,
    "ja-space-between-half-and-full-width": {
      "space": "never"
    },
    "@textlint-rule/pattern": {
      "patterns": [
        {
          "message": "日本語と半角括弧の間に空白を入れない",
          "pattern": "/[\\p{sc=Han}\\p{sc=Hiragana}\\p{sc=Katakana}ー] \\(|\\) [\\p{sc=Han}\\p{sc=Hiragana}\\p{sc=Katakana}ー]/u"
        }
      ]
    }
  }
}
