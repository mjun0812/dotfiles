# すべてのzsh起動時に読み込まれる設定

# XDG Base Directory
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

export EDITOR='vi'
export VISUAL='vi'
export PAGER='less'
[[ "$OSTYPE" == darwin* ]] && export BROWSER='open'

# Ubuntuの/etc/zsh/zshrcは~/.zshrcより先にcompinitを実行し、~/.config/zsh_completionsの無い.zcompdumpを作る。
# completion.zshのcompinit -Cがその作りたてのdumpを使うので_miseなどが登録されない。compinitはcompletion.zshだけで行う
skip_global_compinit=1

# Tool settings
export CUDA_HOME="/usr/local/cuda"

export BUN_INSTALL_BIN="$HOME/.bun/bin"
export BUN_INSTALL_GLOBAL_DIR="$HOME/.bun/install/global"

export PNPM_HOME="$HOME/.local/share/pnpm"
export EZA_CONFIG_DIR="$HOME/.config/eza"

# GCLOUD SDKの自動アップデートを無効化する
export CLOUDSDK_COMPONENT_MANAGER_DISABLE_UPDATE_CHECK=1

# Antigravity CLIの自動アップデートを無効化する (miseの管理するバイナリを書き換えるため)。値はtrueだけが有効で、1は無視される
export AGY_CLI_DISABLE_AUTO_UPDATE=true

# agentsviewのテレメトリを無効化する
export AGENTSVIEW_TELEMETRY_ENABLED=0

# Playwriterのテレメトリを無効化する (relay daemonが起動時に読むため、変更後は`playwriter serve restart`)
export PLAYWRITER_TELEMETRY=0

# uv/cargo-dist系インストーラにrcファイルを書き換えさせない
export INSTALLER_NO_MODIFY_PATH=1

# Vite+のsetupにrcファイルへ追記させない
# $HOME/.vite-plus/env $HOME/.config/vite-plus/env

# login shellを経由しない非対話shell (CI・エディタ・cron) でもPATHをそろえる。
if [[ ! -o LOGIN && -z "$__ZPROFILE_SOURCED" && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then
    source "${ZDOTDIR:-$HOME}/.zprofile"
fi
