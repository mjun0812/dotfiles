export __ZPROFILE_SOURCED=1

# 重複するエントリを自動で除去する
typeset -gU cdpath fpath mailpath path PATH

# Homebrew (Apple Silicon)
if [[ "$OSTYPE" == darwin* ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

export PATH="$PATH:/usr/local/bin:/usr/local/sbin"
export PATH="$PATH:$HOME/.bin"
export PATH="$PATH:/opt/rocm/bin" # ROCm

# Andropid SDK
export PATH="$PATH:$HOME/Library/Android/sdk/platform-tools"
export PATH="$PATH:$HOME/Android/sdk/platform-tools"

export PATH="/usr/lib/wsl/lib:$PATH" # WSL
export PATH="$HOME/bin:$PATH"
export PATH="/usr/local/cuda/bin:$PATH" # CUDA
export PATH="$HOME/.cargo/bin:$PATH" # Rust
export PATH="$HOME/.local/bin:$PATH" # mise, uv tool, Codex
export PATH="$HOME/.venv/bin:$PATH" # Python
export PATH="$HOME/.bun/bin:$PATH" # bun
export PATH="$PNPM_HOME:$PATH"

export LD_LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/lib:$LD_LIBRARY_PATH"

# Vite+ (https://viteplus.dev)
[[ -f "$HOME/.vite-plus/env" ]] && . "$HOME/.vite-plus/env"

# 非対話shellではshim経由でmiseのtoolを解決する (対話shellは ~/.zshrc の mise activate)
if [[ ! -o interactive ]] && command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh --shims)"
fi
